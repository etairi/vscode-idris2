package tally
version = 0.1.0
authors = "A. N. Author"
-- maintainers =
license = "MIT"
brief = "Counts words (fixture for the ipkg grammar)"
-- readme =
-- homepage =
-- sourceloc =
-- bugtracker =

-- the Idris2 version required (e.g. langversion >= 0.5.1)
langversion >= 0.8.0

-- packages to add to search path
depends = base >= 0.8.0
        , contrib
        , elab-util

-- modules to install
modules = Tally
        , Tally.Parse
        , Tally.Parse.Lexer
        , Tally.Report

-- main file (i.e. file to load at REPL)
main = Main

-- name of executable
executable = tally
opts = "--total"
sourcedir = "ipkg-sources"
