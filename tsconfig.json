{
  "compilerOptions": {
    "module": "Node16",
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "types": [
      "node",
      "mocha"
    ],
    "sourceMap": true,
    "rootDir": ".",
    "strict": true,
    // vscode-oniguruma's main.d.ts names the WebAssembly namespace, which only lib.dom declares
    // (not ES2022, not @types/node 24); the grammar tests use it on Node, so library
    // declaration files are not type-checked.
    "skipLibCheck": true
  },
  "include": [
    "src",
    "test"
  ]
}
